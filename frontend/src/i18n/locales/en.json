  "about": {
    "heroTitle": "About Ayers Guitars",
    "heroSubtitle": "Honoring every note with craftsmanship, connecting musical souls worldwide through handcrafted guitars.",
    "storyTitle": "Our Story",
    "storyP1": "Ayers is a world-renowned premium handcrafted guitar brand, built by artisans with decades of experience. From wood selection, structural design, and tonal calibration to intricate inlay work, every step reflects master craftsmanship, combining international luthiery standards with local handcraft techniques to achieve an ideal balance between quality and customization.",
    "storyP2": "The brand name derives from Australia's Ayers Rock (Uluru), the world's largest monolith standing for 600 million years, symbolizing resilience, stability, and culture — the core spirit of the Ayers brand.",
    "storyP3": "Founder Huang Zhen-Fa established a factory in Vietnam in 1989 and officially founded the Ayers brand in 1996. Vietnamese luthiers come from families of woodworkers and shell inlay artisans, averaging over ten years of experience, with many possessing more than twenty years. Every Ayers guitar is entirely handcrafted.",
    "craftAlt": "Ayers Guitar Craftsmanship",
    "valuesTitle": "Brand Values",
    "valuesSubtitle": "Four core values that define every Ayers guitar.",
    "value0Title": "Resilience",
    "value0Desc": "Founded in 1996, inspired by Australia, rooted in Taiwan, committed to fully handcrafted guitars.",
    "value1Title": "Stability",
    "value1Desc": "Pursuing rock-solid tonal stability, infused with the warmth of nature.",
    "value2Title": "Culture",
    "value2Desc": "Promoting local guitar culture through community building.",
    "value3Title": "Craftsmanship",
    "value3Desc": "A guitar's soul is bestowed by human hands; every process is the artisan's devotion.",
