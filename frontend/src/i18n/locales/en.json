  "home": {
    "heroSubtitle": "Handcrafted Since 1996",
    "heroBody": "A world-renowned handcrafted guitar brand inspired by Australia, rooted in Taiwan. Through our exclusive Sunwave acoustic technology and master craftsmanship, we deliver the perfect tone for every player.",
