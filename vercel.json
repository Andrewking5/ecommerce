{
  "rewrites": [
    {
      "source": "/download/blackscreen.mp4",
      "destination": "/videos/ayers-blackscreen.mp4"
    },
    {
      "source": "/download/blackscreen.jpg",
      "destination": "/images/events/ayers-blackscreen.jpg"
    },
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/download/blackscreen.mp4",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"Ayers-blackscreen.mp4\"; filename*=UTF-8''Ayers%E5%AE%98%E6%96%B9%E9%BB%91%E7%95%AB%E9%9D%A2.mp4" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/download/blackscreen.jpg",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"Ayers-blackscreen.jpg\"; filename*=UTF-8''Ayers%E5%AE%98%E6%96%B9%E9%BB%91%E7%95%AB%E9%9D%A2.jpg" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, PATCH, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
